# Install as /opt/symphony-bench/.env on the Coolify host (mode 0400,
# container uid 1000). Do not reuse the production Symphony file or DB.

# Generated independently for this bench deployment.
SYMPHONY_BENCH_TOKEN=
SYMPHONY_ENCRYPTION_KEY=
# Also add this one value to the Coolify application environment. It only
# authenticates worker -> isolated executor and is scrubbed from child commands.
SYMPHONY_BENCH_EXECUTOR_TOKEN=

# Stable routing label pre-created in the isolated Linear team.
SYMPHONY_BENCH_LINEAR_TEAM_ID=492bfef9-26d3-4469-9407-8bc1858ef9ef
SYMPHONY_BENCH_LINEAR_LABEL_ID=b4b92569-f904-4a3f-bef1-ad22fa4851c7
SYMPHONY_BENCH_LINEAR_LABEL_NAME=symphony-bench

# Existing Auth0 tenant is fine; add the generated bench domain to allowed
# callback/logout/web origins and restrict the allowed operator emails.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_ALLOWED_EMAILS=

# OAuth apps must allow callbacks on the bench domain:
#   /api/oauth/github/callback
#   /api/oauth/linear/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
SYMPHONY_OAUTH_PUBLIC_ORIGIN=
